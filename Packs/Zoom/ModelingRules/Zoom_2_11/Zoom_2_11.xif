[MODEL: dataset=zoom_zoom_raw]
filter
    event_type = "activity_log" and type = "Sign in"
| alter
    xdm.event.type = "authentication",
    xdm.event.tags = arraycreate(XDM_CONST.EVENT_TAG_AUTHENTICATION),
    xdm.event.operation = XDM_CONST.OPERATION_TYPE_LOGIN,
    xdm.event.original_event_type = type,
    xdm.event.description = type,
    xdm.event.outcome = XDM_CONST.OUTCOME_SUCCESS,
    xdm.event.outcome_reason = "OTHER",
    xdm.auth.service = "SP",
    xdm.source.ipv4 = ip_address,
    xdm.source.host.device_id = ip_address,
    xdm.source.user.upn = email,
    xdm.source.identity.upn = email,
    xdm.source.user.username = email,
    xdm.source.identity.username = email,
    xdm.target.resource.name = "Zoom",

    get_event_time = parse_timestamp("%Y-%m-%dT%H:%M:%SZ", time),
    xdm.event.original_event_time = get_event_time,

    get_is_service = if(email ~= "^rooms_", true, false),
    xdm.logon.type = if(get_is_service, XDM_CONST.LOGON_TYPE_SERVICE, XDM_CONST.LOGON_TYPE_INTERACTIVE),
    xdm.source.user.user_type = if(get_is_service, XDM_CONST.USER_TYPE_SERVICE_ACCOUNT, XDM_CONST.USER_TYPE_REGULAR),
    xdm.source.identity.user_type = if(get_is_service, XDM_CONST.USER_TYPE_SERVICE_ACCOUNT, XDM_CONST.USER_TYPE_REGULAR),

    get_user_agent = concat(client_type, " ", version),
    xdm.source.user_agent = get_user_agent,

    xdm.source.host.device_category = if(
        client_type in ("win", "mac", "Browser"), "Computer",
        client_type in ("iphone", "android"), "Mobile",
        client_type = "ipad", "Tablet",
        client_type = "watchOS", "IOT",
        null),

    xdm.source.application.name = if(client_type = "Browser", "Browser", null),

    xdm.source.host.os_family = if(
        client_type = "win", XDM_CONST.OS_FAMILY_WINDOWS,
        client_type = "mac", XDM_CONST.OS_FAMILY_MACOS,
        client_type in ("iphone", "ipad", "watchOS"), XDM_CONST.OS_FAMILY_IOS,
        client_type = "android", XDM_CONST.OS_FAMILY_ANDROID,
        null),

    xdm.source.host.os = client_type;

filter
    event_type = "operation_log"
| alter
    xdm.event.type = "saas audit",
    xdm.event.original_event_type = action,
    xdm.event.outcome = XDM_CONST.OUTCOME_SUCCESS,
    xdm.source.user.upn = operator,
    xdm.source.identity.upn = operator,
    xdm.source.user.identifier = operator,
    xdm.source.identity.identifier = operator,
    xdm.source.user.full_domain_name = if(operator ~= "@", arrayindex(split(operator, "@"), 1), null),
    xdm.source.identity.full_domain_name = if(operator ~= "@", arrayindex(split(operator, "@"), 1), null),
    xdm.target.resource.type = category_type,
    xdm.target.resource.name = operation_detail,
    xdm.observer.type = "Zoom",
    xdm.observer.sub_type = category_type,

    get_event_time = parse_timestamp("%Y-%m-%dT%H:%M:%SZ", time),
    xdm.event.original_event_time = get_event_time,

    xdm.event.operation = if(
        action in ("Add", "REST API - Add", "Add Member", "Add Group Admin", "Assign", "REST API - SSO Create"), XDM_CONST.OPERATION_TYPE_CREATE,
        action in ("Delete", "REST API - Delete", "Permanently Delete", "REST API - Permanently Delete", "Delete Member", "Delete Group Admin", "Empty Trash"), XDM_CONST.OPERATION_TYPE_DELETE,
        action in ("Update", "REST API - Update", "Batch Update", "Configure group settings", "Lock", "Unlock", "Trim Recording", "Restore Trimmed Recording", "Cancel Auto Delete", "Disable", "Control"), XDM_CONST.OPERATION_TYPE_MODIFY,
        XDM_CONST.OPERATION_TYPE_OTHER),

    xdm.source.user.user_type = if(
        operator = null or operator = "", null,
        operator ~= "^room_.*@", XDM_CONST.USER_TYPE_SERVICE_ACCOUNT,
        operator ~= "@", XDM_CONST.USER_TYPE_REGULAR,
        XDM_CONST.USER_TYPE_APPLICATION),
    xdm.source.identity.user_type = if(
        operator = null or operator = "", null,
        operator ~= "^room_.*@", XDM_CONST.USER_TYPE_SERVICE_ACCOUNT,
        operator ~= "@", XDM_CONST.USER_TYPE_REGULAR,
        XDM_CONST.USER_TYPE_APPLICATION);
