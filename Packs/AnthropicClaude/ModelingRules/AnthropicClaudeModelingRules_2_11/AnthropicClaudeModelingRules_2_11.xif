[MODEL: dataset="anthropic_claude_raw"]
alter
    get_actor_type               = json_extract_scalar(actor, "$.type"),
    get_actor_email              = coalesce(json_extract_scalar(actor, "$.email_address"), json_extract_scalar(actor, "$.unauthenticated_email_address")),
    get_actor_user_id            = json_extract_scalar(actor, "$.user_id"),
    get_actor_api_key_id         = json_extract_scalar(actor, "$.api_key_id"),
    get_actor_ip                 = json_extract_scalar(actor, "$.ip_address"),
    get_status                   = to_integer(status_code),
    get_target_user_id           = coalesce(user_id, deleted_user_id, if(target_type = "organization_member", target_id, null))
| alter
    get_is_auth                  = if(type ~= "_login_|logged_out", true, false),
    get_is_entity_management     = if(type ~= "^(role_assignment_|rbac_role_|org_user_|api_key_created|scoped_api_key_deleted|group_created|claude_user_role_updated|claude_user_seat_tier_updated)", true, false),
    get_is_file                  = if(type ~= "^(claude_file_|claude_project_document_)", true, false),
    get_actor_ipv4               = if(is_ipv4(get_actor_ip), get_actor_ip, null),
    get_actor_ipv6               = if(is_ipv6(get_actor_ip), get_actor_ip, null)
| alter
    xdm.event.id                 = id,
    xdm.event.original_event_type = type,
    xdm.event.tags               = arraycreate(XDM_CONST.EVENT_TAG_STORY),
    xdm.event.type               = if(get_is_auth, "authentication", get_is_entity_management, "entity management", get_is_file, "File operations", null),
    xdm.event.operation          = if(
        type ~= "_login_", XDM_CONST.OPERATION_TYPE_AUTH_LOGIN,
        type = "user_logged_out", XDM_CONST.OPERATION_TYPE_AUTH_LOGOUT,
        type in ("role_assignment_granted", "rbac_role_assigned"), XDM_CONST.OPERATION_TYPE_ASSIGN_ROLE,
        type = "role_assignment_revoked", XDM_CONST.OPERATION_TYPE_REMOVE_ROLE,
        type = "api_key_created", XDM_CONST.OPERATION_TYPE_ADD_PROGRAMMATIC_CREDENTIAL,
        type = "scoped_api_key_deleted", XDM_CONST.OPERATION_TYPE_REMOVE_PROGRAMMATIC_CREDENTIAL,
        type ~= "_uploaded$", XDM_CONST.OPERATION_TYPE_UPLOAD,
        type ~= "_created$", XDM_CONST.OPERATION_TYPE_CREATE,
        type ~= "_deleted$", XDM_CONST.OPERATION_TYPE_DELETE,
        type ~= "_updated$|_added$", XDM_CONST.OPERATION_TYPE_UPDATE,
        type ~= "_viewed$|_accessed$", XDM_CONST.OPERATION_TYPE_READ,
        null),
    xdm.network.http.url         = url,
    xdm.observer.type            = "anthropic",
    xdm.source.ipv4              = get_actor_ipv4,
    xdm.source.ipv6              = get_actor_ipv6,
    xdm.source.host.ipv4_addresses = if(get_actor_ipv4 != null, arraycreate(get_actor_ipv4), null),
    xdm.source.host.ipv6_addresses = if(get_actor_ipv6 != null, arraycreate(get_actor_ipv6), null),
    xdm.source.user_agent        = json_extract_scalar(actor, "$.user_agent"),
    xdm.source.cloud.project_id  = organization_uuid,
    xdm.source.user.identifier   = coalesce(get_actor_user_id, get_actor_api_key_id),
    xdm.source.user.username     = get_actor_email,
    xdm.source.user.upn          = get_actor_email,
    xdm.source.user.user_type    = if(get_actor_type = "api_actor", XDM_CONST.USER_TYPE_SERVICE_ACCOUNT, null),
    xdm.source.identity.identifier   = coalesce(get_actor_user_id, get_actor_api_key_id),
    xdm.source.identity.username     = get_actor_email,
    xdm.source.identity.upn          = get_actor_email,
    xdm.source.identity.user_type    = if(get_actor_type = "api_actor", XDM_CONST.USER_TYPE_SERVICE_ACCOUNT, null),
    xdm.source.identity.identity_type = if(get_actor_type in ("user_actor", "unauthenticated_user_actor"), XDM_CONST.IDENTITY_TYPE_USER, get_actor_type = "api_actor", XDM_CONST.IDENTITY_TYPE_SERVICE, null),
    xdm.source.identity.realm        = organization_uuid,
    xdm.source.identity.asset.type_id = if(get_actor_type = "user_actor", XDM_CONST.ASSET_TYPE_ANTHROPIC_USER, null),
    xdm.target.user.identifier   = get_target_user_id,
    xdm.target.user.upn          = coalesce(user_email, deleted_user_email),
    xdm.target.identity.identifier   = get_target_user_id,
    xdm.target.identity.upn          = coalesce(user_email, deleted_user_email),
    xdm.target.identity.username     = coalesce(user_email, deleted_user_email),
    xdm.target.identity.identity_type = if(get_target_user_id != null, XDM_CONST.IDENTITY_TYPE_USER, null),
    xdm.target.identity.realm        = if(get_target_user_id != null, organization_uuid, null),
    xdm.target.identity.asset.type_id = if(get_target_user_id != null, XDM_CONST.ASSET_TYPE_ANTHROPIC_USER, null),
    xdm.entity_management.target.type = if(api_key_id != null, XDM_CONST.ENTITY_TYPE_PROGRAMMATIC_CREDENTIALS, role != null or role_id != null, XDM_CONST.ENTITY_TYPE_ROLE, group_id != null, XDM_CONST.ENTITY_TYPE_GROUP, null),
    xdm.entity_management.target.sub_type = if(api_key_id != null, XDM_CONST.ENTITY_SUB_TYPE_API_KEY, null),
    xdm.entity_management.target.id   = coalesce(api_key_id, role_id, group_id),
    xdm.entity_management.target.name = coalesce(api_key_name, role, role_name, group_name),
    xdm.entity_management.entity.id   = coalesce(principal_id, if(target_type = "organization_member", target_id, null)),
    xdm.entity_management.entity.type = if(principal_type = "group", XDM_CONST.ENTITY_TYPE_GROUP, principal_type = "rbac_role", XDM_CONST.ENTITY_TYPE_ROLE, null),
    xdm.entity_management.entity.sub_type = if(target_type = "organization_member", XDM_CONST.ENTITY_SUB_TYPE_USER, null),
    xdm.target.file.id           = coalesce(claude_file_id, claude_project_document_id),
    xdm.target.file.filename     = if(filename = "", null, filename),
    xdm.target.resource.id       = coalesce(claude_chat_id, claude_project_id, claude_artifact_id, environment_id, session_id, mcp_server_id, resource_id),
    xdm.target.resource.type     = if(claude_chat_id != null, "chat", claude_project_id != null, "project", claude_artifact_id != null, "artifact", environment_id != null, "environment", session_id != null, "session", mcp_server_id != null, "mcp_server", resource_type),
    xdm.target.resource.name     = mcp_server_name,
    xdm.auth.auth_method         = auth_method,
    xdm.auth.server              = provider,
    xdm.auth.mfa.method          = if(mfa_method = "not_used", null, mfa_method),
    xdm.auth.mfa.status          = if(mfa_method = "not_used", "skipped", null),
    xdm.event.outcome            = if(
        get_status != null and (get_status < 200 or get_status >= 300), XDM_CONST.OUTCOME_FAILED,
        type ~= "_failed$", XDM_CONST.OUTCOME_FAILED,
        XDM_CONST.OUTCOME_SUCCESS),
    xdm.network.http.response_code = if(get_status = 200, XDM_CONST.HTTP_RSP_CODE_OK, get_status = 201, XDM_CONST.HTTP_RSP_CODE_CREATED, get_status = 202, XDM_CONST.HTTP_RSP_CODE_ACCEPTED, get_status = 204, XDM_CONST.HTTP_RSP_CODE_NO_CONTENT, get_status = 301, XDM_CONST.HTTP_RSP_CODE_MOVED_PERMANENTLY, get_status = 302, XDM_CONST.HTTP_RSP_CODE_FOUND, get_status = 304, XDM_CONST.HTTP_RSP_CODE_NOT_MODIFIED, get_status = 400, XDM_CONST.HTTP_RSP_CODE_BAD_REQUEST, get_status = 401, XDM_CONST.HTTP_RSP_CODE_UNAUTHORIZED, get_status = 403, XDM_CONST.HTTP_RSP_CODE_FORBIDDEN, get_status = 404, XDM_CONST.HTTP_RSP_CODE_NOT_FOUND, get_status = 409, XDM_CONST.HTTP_RSP_CODE_CONFLICT, get_status = 429, XDM_CONST.HTTP_RSP_CODE_TOO_MANY_REQUESTS, get_status = 500, XDM_CONST.HTTP_RSP_CODE_INTERNAL_SERVER_ERROR, get_status = 502, XDM_CONST.HTTP_RSP_CODE_BAD_GATEWAY, get_status = 503, XDM_CONST.HTTP_RSP_CODE_SERVICE_UNAVAILABLE, get_status = 504, XDM_CONST.HTTP_RSP_CODE_GATEWAY_TIMEOUT, null),
    xdm.network.http.method      = if(request_method = "GET", XDM_CONST.HTTP_METHOD_GET, request_method = "POST", XDM_CONST.HTTP_METHOD_POST, request_method = "PUT", XDM_CONST.HTTP_METHOD_PUT, request_method = "DELETE", XDM_CONST.HTTP_METHOD_DELETE, request_method = "PATCH", XDM_CONST.HTTP_METHOD_PATCH, request_method = "HEAD", XDM_CONST.HTTP_METHOD_HEAD, request_method = "OPTIONS", XDM_CONST.HTTP_METHOD_OPTIONS, request_method = null, null, request_method);
