[MODEL: dataset = "nvidia_openshell_raw"]
// OCSF arrives as a JSON object (top-level columns) or as a supervisor log line "<ts> OCSF-JSON {...}" (log column or _raw_log).
alter
    tmp_line = coalesce(log, if(_raw_log != null, json_extract_scalar(concat("{\"v\":", _raw_log, "}"), "$.v"), null))
| alter
    tmp_ocsf = arrayindex(regextract(tmp_line, " OCSF-JSON (\{.*\})\s*$"), 0)
| alter
    tmp_class_uid = coalesce(class_uid, to_integer(json_extract_scalar(tmp_ocsf, "$.class_uid")))
| filter tmp_class_uid != null
| alter
    tmp_metadata = coalesce(metadata, json_extract(tmp_ocsf, "$.metadata")),
    tmp_device = coalesce(device, json_extract(tmp_ocsf, "$.device")),
    tmp_container = coalesce(container, json_extract(tmp_ocsf, "$.container")),
    tmp_actor = coalesce(actor, json_extract(tmp_ocsf, "$.actor")),
    tmp_process = coalesce(process, json_extract(tmp_ocsf, "$.process")),
    tmp_src_endpoint = coalesce(src_endpoint, json_extract(tmp_ocsf, "$.src_endpoint")),
    tmp_dst_endpoint = coalesce(dst_endpoint, json_extract(tmp_ocsf, "$.dst_endpoint")),
    tmp_connection_info = coalesce(connection_info, json_extract(tmp_ocsf, "$.connection_info")),
    tmp_firewall_rule = coalesce(firewall_rule, json_extract(tmp_ocsf, "$.firewall_rule")),
    tmp_http_request = coalesce(http_request, json_extract(tmp_ocsf, "$.http_request")),
    tmp_http_response = coalesce(http_response, json_extract(tmp_ocsf, "$.http_response")),
    tmp_finding_info = coalesce(finding_info, json_extract(tmp_ocsf, "$.finding_info"))
| alter
    tmp_class_name = coalesce(class_name, json_extract_scalar(tmp_ocsf, "$.class_name")),
    tmp_activity_name = coalesce(activity_name, json_extract_scalar(tmp_ocsf, "$.activity_name")),
    tmp_action_id = coalesce(action_id, to_integer(json_extract_scalar(tmp_ocsf, "$.action_id"))),
    tmp_disposition_id = coalesce(disposition_id, to_integer(json_extract_scalar(tmp_ocsf, "$.disposition_id"))),
    tmp_status_id = coalesce(status_id, to_integer(json_extract_scalar(tmp_ocsf, "$.status_id"))),
    tmp_status_detail = coalesce(status_detail, json_extract_scalar(tmp_ocsf, "$.status_detail")),
    tmp_severity_id = coalesce(severity_id, to_integer(json_extract_scalar(tmp_ocsf, "$.severity_id"))),
    tmp_message = coalesce(message, json_extract_scalar(tmp_ocsf, "$.message"))
| alter
    tmp_product_name = json_extract_scalar(tmp_metadata, "$.product.name"),
    tmp_product_version = json_extract_scalar(tmp_metadata, "$.product.version"),
    tmp_event_uid = json_extract_scalar(tmp_metadata, "$.uid"),
    tmp_device_hostname = json_extract_scalar(tmp_device, "$.hostname"),
    tmp_device_uid = json_extract_scalar(tmp_device, "$.uid"),
    tmp_os_name = json_extract_scalar(tmp_device, "$.os.name"),
    tmp_gateway_name = json_extract_scalar(tmp_device, "$.name"),
    tmp_sandbox_id = json_extract_scalar(tmp_container, "$.uid"),
    tmp_sandbox_name = json_extract_scalar(tmp_container, "$.name")
| alter
    tmp_actor_process_name = json_extract_scalar(tmp_actor, "$.process.name"),
    tmp_actor_process_pid = json_extract_scalar(tmp_actor, "$.process.pid"),
    tmp_actor_process_cmd = json_extract_scalar(tmp_actor, "$.process.cmd_line"),
    tmp_target_process_name = json_extract_scalar(tmp_process, "$.name"),
    tmp_target_process_pid = json_extract_scalar(tmp_process, "$.pid"),
    tmp_target_process_cmd = json_extract_scalar(tmp_process, "$.cmd_line")
| alter
    tmp_src_ip = json_extract_scalar(tmp_src_endpoint, "$.ip"),
    tmp_src_port = json_extract_scalar(tmp_src_endpoint, "$.port"),
    tmp_dst_ip = json_extract_scalar(tmp_dst_endpoint, "$.ip"),
    tmp_dst_port = json_extract_scalar(tmp_dst_endpoint, "$.port"),
    tmp_dst_domain = json_extract_scalar(tmp_dst_endpoint, "$.domain"),
    tmp_protocol = json_extract_scalar(tmp_connection_info, "$.protocol_name"),
    tmp_rule_name = json_extract_scalar(tmp_firewall_rule, "$.name"),
    tmp_rule_engine = json_extract_scalar(tmp_firewall_rule, "$.type")
| alter
    tmp_http_method = json_extract_scalar(tmp_http_request, "$.http_method"),
    tmp_url_hostname = json_extract_scalar(tmp_http_request, "$.url.hostname"),
    tmp_url_path = json_extract_scalar(tmp_http_request, "$.url.path"),
    tmp_url_scheme = json_extract_scalar(tmp_http_request, "$.url.scheme"),
    tmp_http_code = json_extract_scalar(tmp_http_response, "$.code"),
    tmp_finding_title = json_extract_scalar(tmp_finding_info, "$.title"),
    tmp_finding_desc = json_extract_scalar(tmp_finding_info, "$.desc")
| alter
    tmp_url_full = if(
        tmp_url_hostname != null and tmp_url_scheme != null,
        concat(tmp_url_scheme, "://", tmp_url_hostname, coalesce(tmp_url_path, "")),
        null)
// A blocked egress attempt emits twice: activity_id 5 (DNS) then 1 (TCP). Downgrading OCSF below 1.8 strips the container object, losing sandbox id.
| alter
    xdm.observer.version = tmp_product_version,
    xdm.observer.type = tmp_product_name,
    xdm.event.id = tmp_event_uid,
    xdm.event.type = tmp_class_name,
    xdm.event.operation_sub_type = tmp_activity_name,
    xdm.event.description = coalesce(tmp_message, tmp_finding_title),
    xdm.alert.description = tmp_finding_desc,
    xdm.alert.name = tmp_finding_title,
    xdm.source.agent.identifier = tmp_sandbox_id,
    xdm.source.host.hostname = coalesce(tmp_sandbox_name, tmp_device_hostname),
    xdm.source.host.device_id = tmp_sandbox_id,
    xdm.source.host.os_family = if(
        tmp_os_name = "Linux", XDM_CONST.OS_FAMILY_LINUX,
        tmp_os_name = "Windows", XDM_CONST.OS_FAMILY_WINDOWS,
        tmp_os_name = "macOS", XDM_CONST.OS_FAMILY_MACOS,
        null),
    xdm.source.ipv4 = tmp_src_ip,
    xdm.source.port = to_integer(tmp_src_port),
    xdm.target.ipv4 = if(
        incidr(tmp_dst_ip, "198.18.0.0/15"), null,
        tmp_dst_ip != null, tmp_dst_ip,
        null),
    xdm.target.port = to_integer(tmp_dst_port),
    xdm.target.host.hostname = coalesce(tmp_dst_domain, tmp_url_hostname),
    xdm.network.ip_protocol = if(
        tmp_protocol = "tcp", XDM_CONST.IP_PROTOCOL_TCP,
        tmp_protocol = "udp", XDM_CONST.IP_PROTOCOL_UDP,
        null),
    xdm.network.http.method = tmp_http_method,
    xdm.network.http.url = tmp_url_full,
    xdm.network.http.response_code = to_string(tmp_http_code),
    xdm.source.process.name = coalesce(tmp_actor_process_name, tmp_target_process_name),
    xdm.source.process.pid = if(
        to_integer(coalesce(tmp_actor_process_pid, tmp_target_process_pid)) != 0,
        to_integer(coalesce(tmp_actor_process_pid, tmp_target_process_pid)),
        null),
    xdm.source.process.command_line = if(
        coalesce(tmp_actor_process_cmd, tmp_target_process_cmd) != "" and coalesce(tmp_actor_process_cmd, tmp_target_process_cmd) != "-",
        coalesce(tmp_actor_process_cmd, tmp_target_process_cmd),
        null),
    xdm.network.rule = tmp_rule_name,
    xdm.observer.name = tmp_device_hostname,
    xdm.observer.unique_identifier = coalesce(tmp_device_uid, tmp_gateway_name, tmp_device_hostname),
    xdm.event.outcome = if(
        tmp_action_id = 2 or tmp_disposition_id = 2, XDM_CONST.OUTCOME_FAILED,
        tmp_action_id = 1 or tmp_disposition_id = 1, XDM_CONST.OUTCOME_SUCCESS,
        tmp_status_id = 1, XDM_CONST.OUTCOME_SUCCESS,
        tmp_status_id = 2, XDM_CONST.OUTCOME_FAILED,
        null),
    xdm.event.outcome_reason = coalesce(tmp_status_detail, tmp_rule_engine),
    xdm.alert.severity = if(
        tmp_severity_id = 1, "Informational",
        tmp_severity_id = 2, "Low",
        tmp_severity_id = 3, "Medium",
        tmp_severity_id = 4, "High",
        tmp_severity_id = 5, "Critical",
        tmp_severity_id = 6, "Critical",
        null);
