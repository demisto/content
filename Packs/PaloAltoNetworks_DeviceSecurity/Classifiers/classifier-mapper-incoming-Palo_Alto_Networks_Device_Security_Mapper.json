{
    "description": "Maps Palo Alto Networks Device Security incidents.",
    "feed": false,
    "id": "Palo Alto Networks Device Security Incoming Mapper",
    "mapping": {
        "Device Security Alert": {
            "dontMapEventToLabels": false,
            "internalMapping": {
                "name": {
                    "simple": "name"
                },
                "occurred": {
                    "simple": "date"
                },
                "details": {
                    "simple": "description"
                },
                "Device Security ServiceNow Table Name": {
                    "simple": "devicesecurityservicenowtablename"
                },
                "Device Security ServiceNow Record ID": {
                    "simple": "url"
                },
                "Alert Title": {
                    "simple": "name"
                },
                "Alert Type": {
                    "simple": "msg.alertType"
                },
                "Alert Unique ID": {
                    "simple": "msg.id"
                },
                "App Name": {
                    "simple": "msg.appName"
                },
                "Client Port": {
                    "simple": "msg.values.[0].value"
                },
                "Created At": {
                    "simple": "created_at"
                },
                "Date": {
                    "simple": "date"
                },
                "Destination Port": {
                    "complex": {
                        "filters": [],
                        "root": ".",
                        "transformers": [
                            {
                                "operator": "FormatDeviceSecurityDestinationPort"
                            }
                        ]
                    }
                },
                "Device Id": {
                    "simple": "deviceid"
                },
                "Device Labels": {
                    "simple": "msg.localDeviceLabels.[0]"
                },
                "Device Local IP": {
                    "simple": "msg.localip"
                },
                "Device Role": {
                    "simple": "msg.localDeviceRole"
                },
                "Device Security MITRE Mappings Raw": {
                    "complex": {
                        "filters": [],
                        "root": "mitre_mappings",
                        "transformers": [
                            {
                                "operator": "Stringify"
                            }
                        ]
                    }
                },
                "Firewall Action": {
                    "simple": "msg.values.[9].value"
                },
                "Firewall Name": {
                    "simple": "msg.values.[7].value"
                },
                "Firewall Serial Number": {
                    "simple": "inspectorid"
                },
                "Forensic Search Timestamp": {
                    "simple": "msg.forensicData.search.timestamp"
                },
                "Inbound Interface": {
                    "simple": "msg.values.[10].value"
                },
                "Message ID": {
                    "simple": "msg.id"
                },
                "Network": {
                    "simple": "msg.remoteHostMetadata.[0].network"
                },
                "Outbound Interface": {
                    "simple": "msg.values.[11].value"
                },
                "Profile": {
                    "simple": "profileId"
                },
                "Profile Category": {
                    "simple": "profileCategory"
                },
                "Profile Confidence Level": {
                    "simple": "display_profile_confidence_level"
                },
                "Profile Vertical": {
                    "simple": "profileVertical"
                },
                "Recommended Actions": {
                    "simple": "msg.recommendation.content"
                },
                "Remote Host Category": {
                    "simple": "msg.remoteHostMetadata.[0].deviceProfileCategory"
                },
                "Remote Host MAC": {
                    "simple": "msg.remoteHostMetadata.[0].deviceMacAddress"
                },
                "Severity (raw / display)": {
                    "complex": {
                        "filters": [],
                        "root": ".",
                        "transformers": [
                            {
                                "operator": "CombineSeverity"
                            }
                        ]
                    }
                },
                "Severity Number": {
                    "simple": "severityNumber"
                },
                "Site ID": {
                    "simple": "siteid"
                },
                "Site Names": {
                    "simple": "siteName"
                },
                "Source IP": {
                    "simple": "msg.fromip"
                },
                "Source Labels": {
                    "simple": "msg.remoteHostLabels.[0]"
                },
                "Threat Category": {
                    "simple": "msg.values.[2].value"
                },
                "Threat ID": {
                    "simple": "msg.values.[1].value"
                },
                "Traffic Direction": {
                    "simple": "msg.trafficDirection"
                },
                "Vendor": {
                    "simple": "vendor"
                }
            }
        },
        "Device Security Vulnerability": {
            "dontMapEventToLabels": false,
            "internalMapping": {
                "name": {
                    "simple": "name"
                },
                "occurred": {
                    "simple": "detected_date"
                },
                "details": {
                    "simple": "vulnerability_name"
                },
                "Device Security Incident URL": {
                    "simple": "devicesecurityincidenturl"
                },
                "Device Security ServiceNow Table Name": {
                    "simple": "devicesecurityservicenowtablename"
                },
                "Device Security ServiceNow Record ID": {
                    "simple": "devicesecurityservicenowrecordid"
                }
            }
        }
    },
    "name": "Palo Alto Networks Device Security Incoming Mapper",
    "type": "mapping-incoming",
    "version": -1,
    "fromVersion": "6.10.0"
}