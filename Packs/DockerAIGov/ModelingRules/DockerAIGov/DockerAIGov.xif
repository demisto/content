[MODEL: dataset = "docker_ai_gov_raw"]
alter
    net_protocol = json_extract_scalar(network_egress, "$.protocol"),
    net_dest_port = json_extract_scalar(network_egress, "$.destination_port"),
    net_exec_success = json_extract_scalar(network_egress_execution, "$.success"),
    net_exec_duration = json_extract_scalar(network_egress_execution, "$.duration_ms"),
    net_exec_error = json_extract_scalar(network_egress_execution, "$.error_class"),
    net_exec_status = json_extract_scalar(network_egress_execution, "$.status_code"),
    fs_mount_mode = json_extract_scalar(filesystem_mount, "$.mount_mode"),
    session_lifecycle = json_extract_scalar(session, "$.lifecycle")
| alter
    activity_class = if(
        action_type in ("tool_invocation", "tool_execution"), "tool",
        action_type in ("resource_read", "resource_read_execution"), "resource",
        action_type in ("prompt", "prompt_execution"), "prompt",
        action_type in ("network_egress", "network_egress_execution"), "network",
        action_type in ("filesystem_mount", "filesystem_mount_execution"), "filesystem",
        action_type in ("session", "policy_sync"), "lifecycle",
        action_type in ("policy_action", "policy_mutation"), "policy_change",
        action_type = "server_registration", "server",
        action_type = "pii_detection", "data_protection",
        action_type = "c_score_report", "risk_score",
        "other"),
    // On network_egress records resource_id is "host:port". IPv6 would break a
    // naive split, so the host is taken as everything before the final colon.
    egress_host = arraystring(arraymap(
        arraycreate(arrayindex(regextract(to_string(resource_id), "^(.*):\d+$"), 0)),
        "@element"), ""),
    egress_port = arrayindex(regextract(to_string(resource_id), ":(\d+)$"), 0)
| alter
    xdm.event.type = to_string(action_type),
    xdm.event.id = audit_event_id,
    xdm.event.description = if(
        resource_id != null, concat(to_string(action_type), ": ", to_string(resource_id)),
        to_string(action_type)),
    xdm.event.outcome = if(
        decision = "AUDIT_DECISION_ALLOW", XDM_CONST.OUTCOME_SUCCESS,
        decision = "AUDIT_DECISION_APPROVAL_ALLOW", XDM_CONST.OUTCOME_SUCCESS,
        decision = "AUDIT_DECISION_DENY", XDM_CONST.OUTCOME_FAILED,
        decision = "AUDIT_DECISION_APPROVAL_DENY", XDM_CONST.OUTCOME_FAILED,
        decision = "AUDIT_DECISION_APPROVAL_TIMEOUT", XDM_CONST.OUTCOME_FAILED,
        decision = "AUDIT_DECISION_APPROVAL_REQUIRED", XDM_CONST.OUTCOME_PARTIAL,
        net_exec_success = "true", XDM_CONST.OUTCOME_SUCCESS,
        net_exec_success = "false", XDM_CONST.OUTCOME_FAILED,
        null),
    // deny_reason arrives as a JSON-encoded string, e.g. '["no applicable
    // policies"]', not an array -- json_extract_scalar reads the first element
    // without the type error arrayindex() would raise.
    xdm.event.outcome_reason = coalesce(json_extract_scalar(deny_reason, "$[0]"), deny_reason, net_exec_error),
    xdm.event.operation = if(
        action_type in ("tool_invocation", "tool_execution"), XDM_CONST.OPERATION_TYPE_EXECUTION,
        action_type in ("resource_read", "resource_read_execution"), XDM_CONST.OPERATION_TYPE_READ,
        action_type in ("filesystem_mount", "filesystem_mount_execution"),
            if(fs_mount_mode = "write", XDM_CONST.OPERATION_TYPE_FILE_WRITE, XDM_CONST.OPERATION_TYPE_FILE_OPEN),
        action_type in ("network_egress", "network_egress_execution"), XDM_CONST.OPERATION_TYPE_CREATE,
        action_type = "session",
            if(session_lifecycle = "SESSION_LIFECYCLE_DELETE", XDM_CONST.OPERATION_TYPE_DELETE, XDM_CONST.OPERATION_TYPE_CREATE),
        action_type in ("policy_action", "policy_mutation", "policy_sync"), XDM_CONST.OPERATION_TYPE_UPDATE,
        null),
    xdm.event.duration = to_integer(net_exec_duration),
    xdm.alert.severity = if(
        decision = "AUDIT_DECISION_APPROVAL_DENY", "HIGH",
        decision = "AUDIT_DECISION_DENY", "MEDIUM",
        decision = "AUDIT_DECISION_APPROVAL_TIMEOUT", "MEDIUM",
        action_type in ("policy_action", "policy_mutation"), "MEDIUM",
        "INFORMATIONAL"),
    xdm.source.user.username = username,
    xdm.source.user.identifier = user_email,
    xdm.source.user.domain = org_name,
    xdm.source.process.name = agent,
    xdm.source.host.hostname = hostname,
    xdm.source.host.os_family = if(
        os = "macos", XDM_CONST.OS_FAMILY_MACOS,
        os = "linux", XDM_CONST.OS_FAMILY_LINUX,
        os = "windows", XDM_CONST.OS_FAMILY_WINDOWS,
        null),
    xdm.network.session_id = audit_session_id,
    xdm.target.host.hostname = if(activity_class = "network", egress_host, null),
    xdm.target.port = if(activity_class = "network", to_integer(coalesce(net_dest_port, egress_port)), null),
    xdm.network.ip_protocol = if(
        net_protocol = "tcp", XDM_CONST.IP_PROTOCOL_TCP,
        net_protocol = "udp", XDM_CONST.IP_PROTOCOL_UDP,
        null),
    xdm.network.http.response_code = to_integer(net_exec_status),
    // Filesystem target. resource_id is the mount path on these records.
    xdm.target.file.path = if(activity_class = "filesystem", to_string(resource_id), null),
    xdm.target.resource.type = to_string(activity_class),
    xdm.target.resource.id = resource_id,
    xdm.observer.vendor = "Docker",
    xdm.observer.product = "AI Governance",
    xdm.observer.version = app_version,
    xdm.observer.type = if(
        client_name = "sbx", "Docker Sandbox",
        client_name = "mcp", "MCP Enterprise Gateway",
        client_name = "connect", "Docker Cloud PEP",
        to_string(client_name)),
    xdm.observer.unique_identifier = sandbox_id;
