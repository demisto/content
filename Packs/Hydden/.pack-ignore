# demisto-sdk pack-ignore
# IN129: partner pack has pytest unit tests in HyddenControl_test.py.
# There is no Cortex CI instance of Hydden Control for a Test Playbook.
# BA129: hydden-blast-radius is a read-only lookup (not a remediation action);
# its account_id argument only matches the User Soft Remediation argument list by name.
[file:HyddenControl.yml]
ignore=IN129,BA129
